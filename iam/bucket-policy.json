{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonHttps",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::document-processing-system-arman-dev",
        "arn:aws:s3:::document-processing-system-arman-dev/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
