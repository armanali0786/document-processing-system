{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowMyLoginRoleToAssume",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::232723757987:root" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::232723757987:role/AccountFullAccessRole"
        }
      }
    }
  ]
}
